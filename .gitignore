# =============================================================================
# .gitignore  –  CAD Automation Pipeline
# =============================================================================

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.installed.cfg
pip-selfcheck.json

# Virtual environments
.venv/
venv/
env/
.conda/

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Model checkpoints & logs
checkpoints/*.pt
checkpoints/*.pth
logs/*.log
logs/*.jsonl

# Dataset files (user-provided)
data/mfcad_plus/hierarchical_graphs/*.h5
data/**/*.h5

# DXF output
output/
*.dxf
*.dxb

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Neo4j local instance data
neo4j_data/

# Test coverage
.coverage
htmlcov/
.pytest_cache/

# Temp
tmp/
*.tmp
